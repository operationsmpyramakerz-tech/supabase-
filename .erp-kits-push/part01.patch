+        ...member,
+        id: text(member?.id),
+        name: text(member?.name) || "Unnamed",
+        stocktakingColumn: text(member?.stocktakingColumn || member?.school || stockField?.value),
+      };
+    })
+    .filter((member) => {
+      if (!member.id || !member.name || seen.has(member.id)) return false;
+      seen.add(member.id);
+      return true;
+    })
+    .sort((a, b) => a.name.localeCompare(b.name));
