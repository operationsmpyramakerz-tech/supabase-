+    const baseName = text(file.name).replace(/\.[^.]+$/, "") || "receipt";
+    return {
+      dataUrl: await readFileAsDataUrl(bestBlob),
+      name: `${baseName}.${bestType === "image/webp" ? "webp" : "jpg"}`,
+      size: bestBlob.size,
+    };
+  } finally {
+    URL.revokeObjectURL(objectUrl);
+  }
