{
  "name": "notion-order-dashboard",
  "version": "1.0.0",
  "description": "An order management dashboard connected to Notion.",
  "private": true,
  "scripts": {
    "dev": "node server/local.js",
    "start": "node server/local.js",
    "start:cluster": "pm2-runtime start ecosystem.config.cjs --env production",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "pdfkit": "^0.17.2",
    "connect-redis": "^7.1.1",
    "redis": "^4.6.14",
    "@vercel/blob": "^2.0.0",
    "exceljs": "^4.3.0",
    "web-push": "^3.6.7"
  }
}
