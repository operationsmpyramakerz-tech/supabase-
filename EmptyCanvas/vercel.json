    },
    {
      "source": "/api/products/proposals/:id/:kind(pdf|excel)",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/export-direct?scope=proposal&id=:id&kind=:kind"
    },
    {
      "source": "/api/products/kits/:id/:kind(pdf|excel)",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/export-direct?scope=kit&id=:id&kind=:kind"
    },
    {
      "source": "/api/products/proposals/:id/send-to-stock",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/send-to-stock?id=:id"
    },
    {
      "source": "/api/products/proposals/:id/make-order",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/make-order?id=:id"
    },
    {
      "source": "/api/products/proposals/:id/items/by-kit",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/items-by-kit?id=:id"
    },
    {
      "source": "/api/products/proposals/:id/items/by-tag",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/items-by-tag?id=:id"
    },
    {
      "source": "/api/products/proposals/combine/save",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/combine/save"
    },
    {
      "source": "/api/products/kits/:id/send-to-stock",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits/send-to-stock?id=:id"
    },
    {
      "source": "/api/products/proposals",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals"
    },
    {
      "source": "/api/products/proposals/:id/copy",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/:id/copy"
    },
    {
      "source": "/api/products/proposals/:id/items",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/:id/items"
    },
    {
      "source": "/api/products/proposals/:id/items/:itemId((?!by-tag|by-kit)[^/]+)",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/:id/items/:itemId"
    },
    {
      "source": "/api/products/proposals/receipt-upload",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/receipt-upload"
    },
    {
      "source": "/api/products/proposals/:id",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/proposals/:id"
    },
    {
      "source": "/api/products/kits",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits"
    },
    {
      "source": "/api/products/kits/:id/copy",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits/:id/copy"
    },
    {
      "source": "/api/products/kits/:id/items",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits/:id/items"
    },
    {
      "source": "/api/products/kits/:id/items/:itemId",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits/:id/items/:itemId"
    },
    {
      "source": "/api/products/kits/:id",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/kits/:id"
    },
    {
      "source": "/api/expenses/screenshot/:expenseId",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/expenses/screenshot-direct?expenseId=:expenseId"
    },
    {
      "source": "/api/expenses/export/:kind(pdf|excel)",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/expenses/export-direct?kind=:kind"
    },
    {
      "source": "/api/products/:id((?!admin|proposals|kits|tags|units)[^/]+)",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 9 * * *"
    }
  ]
}
