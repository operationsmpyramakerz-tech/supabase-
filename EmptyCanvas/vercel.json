{
  "rewrites": [
    {
      "source": "/api/products/admin/verify",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/admin/verify"
    },
    {
      "source": "/api/products",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products"
    },
    {
      "source": "/api/products/tags",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/tags"
    },
    {
      "source": "/api/products/units",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/units"
    },
    {
      "source": "/api/products/proposals/team-members",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/team-members"
    },
    {
      "source": "/api/products/:id/image",
      "destination": "https://operations-hub-next-pilot.vercel.app/next/api/products/image?id=:id"
    },
    {
      "source": "/api/products/proposals/combine/:kind(pdf|excel)",
