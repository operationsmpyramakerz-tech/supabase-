{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/expenses/screenshot/:expenseId",
      "destination": "/next/api/expenses/screenshot-direct?expenseId=:expenseId"
    },
    {
      "source": "/api/expenses/export/:kind(pdf|excel)",
      "destination": "/next/api/expenses/export-direct?kind=:kind"
    },
    {
      "source": "/api/orders/requested/paged-summary",
      "destination": "/next/api/orders/requested/paged-summary"
    },
    {
      "source": "/api/orders/requested/details-direct",
      "destination": "/next/api/orders/requested/details-direct"
    },
    {
      "source": "/api/orders/operations/mutations-direct",
      "destination": "/next/api/orders/operations/mutations-direct"
    },
    {
      "source": "/api/sv-orders/paged-summary",
      "destination": "/next/api/sv-orders/paged-summary"
    },
    {
      "source": "/api/sv-orders/details-direct",
      "destination": "/next/api/sv-orders/details-direct"
    },
    {
      "source": "/api/sv-orders/mutations-direct",
      "destination": "/next/api/sv-orders/mutations-direct"
    },
    {
      "source": "/api/products/admin/verify",
      "destination": "/next/api/products/admin/verify"
    },
    {
      "source": "/api/products",
      "destination": "/next/api/products"
    },
    {
      "source": "/api/products/tags",
      "destination": "/next/api/products/tags"
    },
    {
      "source": "/api/products/units",
      "destination": "/next/api/products/units"
    },
    {
      "source": "/api/products/:id((?!admin|proposals|kits|tags|units)[^/]+)",
      "destination": "/next/api/products/:id"
    },
    {
      "source": "/api/products/proposals",
      "destination": "/next/api/products/proposals"
    },
    {
      "source": "/api/products/proposals/receipt-upload",
      "destination": "/next/api/products/proposals/receipt-upload"
    },
    {
      "source": "/api/products/kits/:id/send-to-stock",
      "destination": "/next/api/products/kits/:id/send-to-stock"
    },
    {
      "source": "/api/products/proposals/:id/make-order",
      "destination": "/next/api/products/proposals/:id/make-order"
    },
    {
      "source": "/api/products/proposals/:id/send-to-stock",
      "destination": "/next/api/products/proposals/:id/send-to-stock"
    },
    {
      "source": "/api/products/proposals/:id/items/by-kit",
      "destination": "/next/api/products/proposals/items-by-kit?id=:id"
    },
    {
      "source": "/api/products/proposals/combine/save",
      "destination": "/next/api/products/proposals/combine/save"
    },
    {
      "source": "/api/products/proposals/:id/copy",
      "destination": "/next/api/products/proposals/:id/copy"
    },
    {
      "source": "/api/products/proposals/:id/items",
      "destination": "/next/api/products/proposals/:id/items"
    },
    {
      "source": "/api/products/proposals/:id/items/:itemId((?!by-tag|by-kit)[^/]+)",
      "destination": "/next/api/products/proposals/:id/items/:itemId"
    },
    {
      "source": "/api/products/proposals/:id((?!receipt-upload)[^/]+)",
      "destination": "/next/api/products/proposals/:id"
    },
    {
      "source": "/api/products/kits",
      "destination": "/next/api/products/kits"
    },
    {
      "source": "/api/products/kits/:id/copy",
      "destination": "/next/api/products/kits/:id/copy"
    },
    {
      "source": "/api/products/kits/:id/items",
      "destination": "/next/api/products/kits/:id/items"
    },
    {
      "source": "/api/products/kits/:id/items/:itemId",
      "destination": "/next/api/products/kits/:id/items/:itemId"
    },
    {
      "source": "/api/products/kits/:id",
      "destination": "/next/api/products/kits/:id"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/next/login",
      "permanent": false
    }
  ]
}
