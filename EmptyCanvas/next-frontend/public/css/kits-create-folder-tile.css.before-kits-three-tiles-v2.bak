/* Kits only — dashed Create folder, menu expands grid instead of covering it. */
body.kits-page .next-kits-classic-parity .kit-library-heading {
  display:flex !important; align-items:center; justify-content:space-between;
  gap:12px; min-height:55px; padding:0 0 15px; margin:0 0 14px;
  border-bottom:1px solid #eceef1;
}
body.kits-page .next-kits-classic-parity .kit-library-heading__title {
  display:flex; align-items:center; gap:11px; min-width:0;
}
body.kits-page .next-kits-classic-parity .kit-library-heading__icon {
  width:42px; height:42px; flex:0 0 42px; display:grid; place-items:center;
  background:#f4f5f7; border:1px solid #eef0f2; border-radius:13px; color:#111827;
}
body.kits-page .next-kits-classic-parity .kit-library-heading__icon svg { width:23px; height:23px; }
body.kits-page .next-kits-classic-parity .kit-library-heading h2 {
  font-size:1.22rem; line-height:1.2; letter-spacing:-.025em;
  color:#101828; font-weight:950; margin:0;
}
body.kits-page .next-kits-classic-parity .kit-library-heading__count {
  flex:0 0 auto; display:inline-flex; align-items:center; min-height:34px;
  padding:0 12px; border-radius:999px; background:#f3f4f6;
  color:#667085; font-size:.73rem; font-weight:850; white-space:nowrap;
}
/* Closed footprint matches a 154 x 144 folder card. */
body.kits-page .next-kits-classic-parity .kit-library-grid > .kit-quick-create {
  display:flex !important; flex-direction:column !important; align-self:start;
  position:relative !important; width:154px !important; max-width:100% !important;
  height:auto !important; min-height:144px !important; padding:0 !important;
  margin:0 !important; gap:10px !important; min-width:0 !important;
  box-sizing:border-box !important;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__tile {
  display:flex !important; flex-direction:column !important; align-items:center !important;
  justify-content:center !important; gap:4px !important; text-align:center;
  box-sizing:border-box !important; width:100% !important; height:144px !important;
  min-height:144px !important; flex:0 0 144px; padding:12px 6px !important;
  border:2px dashed #98a2b3 !important; border-radius:20px !important;
  background:linear-gradient(145deg,#fff,#f8fafc) !important;
  box-shadow:none !important; color:#111827 !important; cursor:pointer;
  transition:border-color .17s ease,background .17s ease;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__tile:hover,
body.kits-page .next-kits-classic-parity .kit-quick-create__tile[aria-expanded="true"] {
  border-color:#f97316 !important; background:linear-gradient(145deg,#fff,#fff7ed) !important;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__tile:focus-visible {
  outline:3px solid rgba(249,115,22,.3); outline-offset:3px;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__illustration {
  position:relative; display:grid; place-items:center; width:52px; height:50px;
  margin-bottom:2px; color:#98a2b3;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__illustration svg {
  width:44px; height:44px; stroke-width:1.6;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__spark {
  position:absolute; top:0; right:-6px; width:3px; height:11px;
  border-radius:999px; background:#fb923c; transform:rotate(30deg);
  box-shadow:9px 9px 0 -1px #fdba74; pointer-events:none;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__tile strong {
  color:#111827 !important; font-weight:950; font-size:1.06rem; line-height:1.1;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__tile small {
  max-width:100%; color:#667085; font-size:.60rem;
  font-weight:700; line-height:1.3; white-space:normal;
}
/* This menu is IN FLOW, not positioned over the next row. */
body.kits-page .next-kits-classic-parity .kit-quick-create__menu {
  display:flex !important; flex-direction:column; position:relative !important;
  inset:auto !important; width:100% !important; min-width:0 !important;
  box-sizing:border-box !important; margin:0 !important; padding:5px !important;
  border:1px solid #e3e6eb !important; border-radius:16px !important;
  background:#fff !important; box-shadow:0 12px 28px rgba(15,23,42,.13) !important;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__menu::before {
  content:""; position:absolute; top:-7px; left:calc(50% - 6px);
  width:12px; height:12px; transform:rotate(45deg); background:#fff;
  border-left:1px solid #e3e6eb; border-top:1px solid #e3e6eb;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__menu button {
  display:flex !important; align-items:center; gap:6px; width:100% !important;
  min-height:42px !important; padding:8px 6px !important;
  border:0 !important; border-radius:10px !important;
  background:transparent !important; color:#101828 !important;
  font:inherit; font-size:.69rem; font-weight:850; line-height:1.15;
  white-space:nowrap; text-align:left; cursor:pointer;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__menu button + button {
  border-top:1px solid #edf0f2 !important; border-radius:0 0 10px 10px !important;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__menu button:hover,
body.kits-page .next-kits-classic-parity .kit-quick-create__menu button:focus-visible {
  background:#fff7ed !important; outline:0;
}
body.kits-page .next-kits-classic-parity .kit-quick-create__menu svg {
  flex:0 0 18px; width:18px; height:18px; color:#101828;
}
body.kits-page .next-kits-classic-parity .kit-library-grid {
  grid-auto-rows:max-content !important; align-items:start !important;
}
@media(max-width:640px) {
  body.kits-page .next-kits-classic-parity .kit-library-heading {gap:8px; min-height:49px; padding-bottom:12px; margin-bottom:10px;}
  body.kits-page .next-kits-classic-parity .kit-library-heading__icon {width:36px; height:36px; flex-basis:36px; border-radius:12px;}
  body.kits-page .next-kits-classic-parity .kit-library-heading__icon svg {width:20px; height:20px;}
  body.kits-page .next-kits-classic-parity .kit-library-heading h2 {font-size:1.08rem;}
  body.kits-page .next-kits-classic-parity .kit-library-heading__count {min-height:30px; padding:0 10px; font-size:.68rem;}
}
@media(prefers-reduced-motion:reduce) {
  body.kits-page .next-kits-classic-parity .kit-quick-create__tile {transition:none;}
}
